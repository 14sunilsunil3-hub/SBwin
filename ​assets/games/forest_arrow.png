<div onclick="showToast('Launching Forest Arrow...')" class="bg-gray-900 rounded-2xl overflow-hidden shadow-md border border-orange-200 cursor-pointer">
  <div class="h-28 w-full bg-gray-800">
    <img src="/assets/games/forest_arrow.png" alt="Forest Arrow" class="w-full h-full object-cover">
  </div>
  <div class="p-1.5 bg-white text-gray-800 text-[10px]">
    <p class="text-gray-400 text-[8px] uppercase font-semibold">INOUT</p>
    <p class="font-bold truncate">Forest Arrow</p>
  </div>
</div>
