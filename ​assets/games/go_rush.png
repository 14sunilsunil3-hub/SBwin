<div onclick="showToast('Launching Go Rush...')" class="bg-gray-900 rounded-2xl overflow-hidden shadow-md border border-orange-200 cursor-pointer">
  <div class="h-28 w-full bg-gray-800">
    <img src="/assets/games/go_rush.png" alt="Go Rush" class="w-full h-full object-cover">
  </div>
  <div class="p-1.5 bg-white text-gray-800 text-[10px]">
    <p class="text-gray-400 text-[8px] uppercase font-semibold">JILI</p>
    <p class="font-bold truncate">Go Rush</p>
  </div>
</div>
